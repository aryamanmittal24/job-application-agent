{
  "manifest_version": 3,
  "name": "JobPilot Autofill",
  "version": "0.1.0",
  "description": "Fill known application fields from your private local JobPilot profile.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:4010/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "JobPilot Autofill",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://jobs.ashbyhq.com/*",
        "https://apply.workable.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
